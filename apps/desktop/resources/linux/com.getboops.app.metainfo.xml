<component type="desktop-application">
  <id>com.getboops.app</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Boops</name>
  <summary>Your own persistent personal bots</summary>
  <developer id="com.getboops">
    <name>T3 Tools Inc.</name>
  </developer>
  <description>
    <p>
      Boops is a self-hosted app for running persistent personal bots. Each
      bot has its own name, persona, memory, and routines, and runs on your
      existing agent subscriptions.
    </p>
    <p>
      Talk to your bots from desktop, web, or mobile.
    </p>
  </description>
