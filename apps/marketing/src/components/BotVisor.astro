---
// A Boops bot in the Visor style, matching packages/client-runtime's avatar shapes (64×64 grid).
interface Props {
  hue: number;
  state?: "idle" | "working" | "needs" | "sleep";
  accessory?: "none" | "antenna" | "handle" | "phones";
  glow?: string;
  size?: number;
  label?: string;
}
const { hue, state = "idle", accessory = "none", glow = "#86ffcf", size = 34, label } = Astro.props;
const body = `hsl(${hue} 62% 66%)`;
const shade = `hsl(${hue} 40% 46%)`;
const cy = 37;
const pill = (cx: number, w: number, h: number) => ({ x: cx - w / 2, y: cy - h / 2, w, h, r: Math.min(w, h) / 2 });
const eyes =
  state === "working"
    ? [pill(24, 9, 4), pill(38, 9, 4)]
    : state === "needs"
      ? [pill(25, 6.5, 12), pill(39, 6.5, 12)]
      : state === "sleep"
        ? [pill(25, 8, 2), pill(39, 8, 2)]
        : [pill(25, 6, 10), pill(39, 6, 10)];
const eyeFill = state === "needs" ? "#ffc23d" : glow;
const eyeOpacity = state === "sleep" ? 0.45 : 1;
---

<svg
  class="bot-visor"
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  {
    accessory === "antenna" && (
      <>
        <path d="M32 12V5" stroke={shade} stroke-width="2.6" stroke-linecap="round" />
        <circle cx="32" cy="5" r="3.2" fill={glow} />
      </>
    )
  }
  {accessory === "handle" && <path d="M21 13q11-9 22 0" fill="none" stroke={shade} stroke-width="3" stroke-linecap="round" />}
  {
    accessory === "phones" && (
      <>
        <rect x="5" y="30" width="6" height="14" rx="3" fill={shade} />
        <rect x="53" y="30" width="6" height="14" rx="3" fill={shade} />
        <path d="M8 30q0-24 24-24t24 24" fill="none" stroke={shade} stroke-width="2.4" stroke-linecap="round" />
      </>
    )
  }
  <rect x="10" y="12" width="44" height="44" rx="16" fill={body} />
  <rect x="13" y="26" width="38" height="22" rx="11" fill="#1d1a2a" />
  <path d="M18 30q4-2.5 9-2.5" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" opacity="0.35" />
  {eyes.map((e) => <rect x={e.x} y={e.y} width={e.w} height={e.h} rx={e.r} fill={eyeFill} opacity={eyeOpacity} />)}
</svg>
