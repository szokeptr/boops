---
import { getImage, Image } from "astro:assets";
import appIcon from "../assets/icon.webp";
import socialCard from "../assets/social-card.webp";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
}

const {
  title = "Boops: little bots that live on your machine",
  description = "Boops runs one or many personal bots on your own computer or VPS. Each has a name, a memory, routines, and one long conversation, powered by the Claude or Codex plan you already pay for.",
  pageClass,
} = Astro.props;

// Link unfurlers require a 1200x630 JPG/PNG at an absolute URL.
const socialImage = await getImage({
  src: socialCard,
  width: 1200,
  height: 630,
  format: "jpg",
  quality: 90,
});
const socialImageUrl = new URL(socialImage.src, Astro.site);
const socialImageAlt = "Boops: little bots that live on your machine.";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Boops" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <meta name="theme-color" content="#FBF8F1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400;500;600;700&family=Martian+Mono:wght@400;500&family=Silkscreen&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class:list={["page", pageClass]}>
      <nav class="nav">
        <div class="nav-inner">
          <a href="/" class="nav-brand" aria-label="Boops home">
            <Image
              src={appIcon}
              alt=""
              width={28}
              height={28}
              densities={[1, 2, 3]}
              format="webp"
              quality={90}
              loading="eager"
              decoding="async"
            />
            <svg
              class="nav-brand-name"
              viewBox="0 0 29 9"
              height="18"
              width="58"
              shape-rendering="crispEdges"
              aria-hidden="true"
            >
              <path d="M0 0h2v1h-2zM0 1h2v1h-2zM11 1h1v1h-1zM0 2h4v1h-4zM7 2h3v1h-3zM13 2h3v1h-3zM18 2h4v1h-4zM25 2h4v1h-4zM0 3h2v1h-2zM3 3h2v1h-2zM6 3h1v1h-1zM10 3h1v1h-1zM12 3h1v1h-1zM16 3h1v1h-1zM18 3h2v1h-2zM21 3h2v1h-2zM24 3h2v1h-2zM0 4h2v1h-2zM3 4h2v1h-2zM6 4h1v1h-1zM10 4h1v1h-1zM12 4h1v1h-1zM16 4h1v1h-1zM18 4h2v1h-2zM21 4h2v1h-2zM25 4h3v1h-3zM0 5h2v1h-2zM3 5h2v1h-2zM6 5h1v1h-1zM10 5h1v1h-1zM12 5h1v1h-1zM16 5h1v1h-1zM18 5h2v1h-2zM21 5h2v1h-2zM27 5h2v1h-2zM0 6h4v1h-4zM7 6h3v1h-3zM13 6h3v1h-3zM18 6h4v1h-4zM24 6h4v1h-4zM18 7h2v1h-2zM18 8h2v1h-2z" fill="currentColor"></path>
              <path d="M11 0h1v1h-1zM8 3h2v1h-2zM14 3h2v1h-2zM7 4h3v1h-3zM13 4h3v1h-3zM7 5h3v1h-3zM13 5h3v1h-3z" fill="#86ffcf"></path>
              <path d="M7 3h1v1h-1zM13 3h1v1h-1z" fill="#ffffff"></path>
            </svg>
          </a>
          <div class="nav-right">
            <a class="nav-link" href="/#bots">Bots</a>
            <a class="nav-link" href="/#self-host">Self-host</a>
            <a class="nav-link nav-link--cta" href="/download">Download</a>
          </div>
        </div>
      </nav>

      <main class="main">
        <slot />
      </main>

      <footer class="footer">
        <div class="footer-inner">
          <div class="footer-brand">
            <Image
              src={appIcon}
              alt=""
              width={20}
              height={20}
              densities={[1, 2, 3]}
              format="webp"
              quality={90}
              loading="lazy"
              decoding="async"
            />
            <span>Boops · open source · MIT licensed</span>
          </div>
          <div class="footer-links">
            <a href="/#bots">Bots</a>
            <a href="/#self-host">Self-host</a>
            <a href="/download">Download</a>
          </div>
        </div>
      </footer>
    </div>

    <script>
      const nav = document.querySelector(".nav");
      const onScroll = () => {
        if (!nav) return;
        if (window.scrollY > 12) nav.classList.add("is-scrolled");
        else nav.classList.remove("is-scrolled");
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --paper: #fbf8f1;
    --ink: #25223a;
    --night: #15141c;
    --phosphor: #86ffcf;
    --amber: #ffc23d;
    --blue: #5aa9ff;
    --sand: #f1ebdd;
    --line: #e7e1d3;
    --muted: #6e6a80;

    --bg: var(--paper);
    --bg-elev: var(--sand);
    --bg-card: #fffdf8;
    --fg: var(--ink);
    --fg-muted: #4a4660;
    --fg-dim: var(--muted);
    --fg-faint: #9a95ae;
    --border: var(--line);
    --border-strong: #d6cfbe;
    --accent: var(--ink);
    --ok: #2f9e6f;
    --warn: var(--amber);
    --font-sans: "Familjen Grotesk", system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-pixel: "Silkscreen", ui-monospace, monospace;
    --font-mono: "Martian Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    --radius: 12px;
    --radius-sm: 8px;
    --radius-lg: 16px;
  }

  /* Night surface: the dark sections and the download page. */
  .is-night {
    --bg: var(--night);
    --bg-elev: #1c1b25;
    --bg-card: #0e0d13;
    --fg: #ece9f5;
    --fg-muted: #a9a5be;
    --fg-dim: #8c88a3;
    --fg-faint: #6f6b86;
    --border: rgba(255, 255, 255, 0.08);
    --border-strong: rgba(255, 255, 255, 0.14);
    --accent: var(--phosphor);
    --ok: var(--phosphor);
    color-scheme: dark;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    color-scheme: light;
    scroll-behavior: smooth;
  }

  body {
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    min-height: 100vh;
    overflow-x: hidden;
    line-height: 1.5;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font-family: inherit;
    cursor: pointer;
    border: 0;
    background: none;
    color: inherit;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  code {
    font-family: var(--font-mono);
  }

  .pixel,
  .eyebrow {
    font-family: var(--font-pixel);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 400;
    color: var(--fg-dim);
  }

  .display {
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .container {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-weight: 600;
    font-size: 14px;
    padding: 10px 18px;
    border-radius: 999px;
    transition: transform 0.18s ease, background 0.18s ease,
      border-color 0.18s ease, color 0.18s ease;
    white-space: nowrap;
  }

  .btn-primary {
    background: var(--ink);
    color: var(--paper);
  }

  .is-night .btn-primary {
    background: var(--phosphor);
    color: var(--ink);
  }

  .btn-primary:hover {
    transform: translateY(-1px);
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  .btn-ghost {
    color: var(--fg);
    border: 1.5px solid var(--border-strong);
    background: transparent;
  }

  .btn-ghost:hover {
    border-color: var(--fg);
  }

  .btn-lg {
    padding: 14px 24px;
    font-size: 15px;
  }

  .tile {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    overflow: hidden;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Page-load sequence: [data-rise] plays once with delay --d. */
  @keyframes rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }
  [data-rise] {
    animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--d, 0ms);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-rise] { animation: none; }
  }
</style>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: clip;
    background: var(--bg);
    color: var(--fg);
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease;
  }

  .nav.is-scrolled {
    border-bottom-color: var(--border);
  }

  .nav-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 14px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--fg);
  }

  .nav-brand img {
    width: 28px;
    height: 28px;
    border-radius: 7px;
    image-rendering: pixelated;
  }

  .nav-brand-name {
    display: block;
    flex: none;
  }

  .nav-right {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .nav-link {
    padding: 8px 12px;
    color: var(--fg-muted);
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    transition: color 0.18s ease;
  }

  .nav-link:hover {
    color: var(--fg);
  }

  .nav-link--cta {
    margin-left: 6px;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
  }

  .nav-link--cta:hover {
    color: var(--paper);
  }

  .is-night .nav-link--cta {
    background: var(--phosphor);
    color: var(--ink);
  }

  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    padding: 40px 0 32px;
  }

  .footer-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: center;
    justify-content: space-between;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--fg-dim);
  }

  .footer-brand img {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    image-rendering: pixelated;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 20px;
  }

  .footer-links a {
    font-size: 13px;
    color: var(--fg-muted);
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--fg);
  }

  @media (max-width: 820px) {
    .nav-inner,
    .footer-inner {
      padding-left: 20px;
      padding-right: 20px;
    }

    .footer {
      padding-bottom: max(32px, env(safe-area-inset-bottom));
    }

    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 20px;
    }
  }

  @media (max-width: 520px) {
    .nav-link:not(.nav-link--cta) {
      display: none;
    }
  }
</style>
