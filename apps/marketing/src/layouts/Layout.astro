---
import { getImage, Image } from "astro:assets";
import appIcon from "../assets/icon.webp";
import socialCard from "../assets/social-card.webp";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
}

const {
  title = "Boops: little bots that live on your machine",
  description = "Boops runs one or many personal bots on your own computer or VPS. Each has a name, a memory, routines, and one long conversation, powered by the Claude or Codex plan you already pay for.",
  pageClass,
} = Astro.props;

// Link unfurlers require a 1200x630 JPG/PNG at an absolute URL.
const socialImage = await getImage({
  src: socialCard,
  width: 1200,
  height: 630,
  format: "jpg",
  quality: 90,
});
const socialImageUrl = new URL(socialImage.src, Astro.site);
const socialImageAlt = "Boops: little bots that live on your machine.";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Boops" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <meta name="theme-color" content="#FBF8F1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400;500;600;700&family=Martian+Mono:wght@400;500&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class:list={["page", pageClass]}>
      <nav class="nav">
        <div class="nav-inner">
          <a href="/" class="nav-brand" aria-label="Boops home">
            <svg
              class="nav-lockup"
              viewBox="0 -860 3951 1100"
              height="28"
              width="101"
              aria-hidden="true"
            >
              <g transform="translate(0 -860) scale(17.1875)">
                <rect width="64" height="64" rx="15" fill="#1d1a2a"></rect>
                <rect x="8" y="20" width="48" height="26" rx="13" fill="#2f2b45"></rect>
                <rect x="19" y="26" width="8" height="14" rx="4" fill="#86ffcf"></rect>
                <rect x="37" y="26" width="8" height="14" rx="4" fill="#86ffcf"></rect>
              </g>
              <path transform="translate(1340 0)" fill="currentColor" d="M309 8Q260 8 222.5 -12.5Q185 -33 160.5 -68Q136 -103 123.5 -148Q111 -193 112 -244Q112 -293 125 -338Q138 -383 162.5 -417Q187 -451 223.5 -470.5Q260 -490 309 -490Q353 -490 394.5 -470Q436 -450 468 -415.5Q500 -381 518.5 -336.5Q537 -292 537 -243Q537 -192 518.5 -146.5Q500 -101 468 -66Q436 -31 395 -11.5Q354 8 309 8ZM288 -140Q316 -140 338 -153.5Q360 -167 373.5 -190Q387 -213 387 -241Q387 -270 374 -292.5Q361 -315 339 -328Q317 -341 289 -341Q262 -341 239.5 -328Q217 -315 204.5 -292.5Q192 -270 192 -241Q192 -213 205 -190Q218 -167 240 -153.5Q262 -140 288 -140ZM114 9Q78 9 62 -2Q46 -13 42.5 -30.5Q39 -48 39 -67L39 -642Q39 -663 43 -680Q47 -697 62.5 -707.5Q78 -718 115 -718Q151 -718 166 -707Q181 -696 184 -678.5Q187 -661 186 -642L186 -36Q181 -13 165 -2Q149 9 114 9ZM824 17Q777 17 730.5 -1.5Q684 -20 646 -54Q608 -88 586 -135.5Q564 -183 564 -241Q564 -295 584 -341.5Q604 -388 640 -424Q676 -460 722.5 -480.5Q769 -501 822 -501Q894 -501 952.5 -466.5Q1011 -432 1046 -373Q1081 -314 1081 -242Q1081 -181 1058.5 -133.5Q1036 -86 998.5 -52Q961 -18 915.5 -0.5Q870 17 824 17ZM822 -134Q846 -134 871 -146Q896 -158 913 -182Q930 -206 930 -243Q930 -275 916 -299Q902 -323 877.5 -336.5Q853 -350 821 -350Q791 -350 767.5 -336Q744 -322 729.5 -297.5Q715 -273 715 -242Q715 -206 731.5 -181.5Q748 -157 773 -145.5Q798 -134 822 -134ZM1363 17Q1316 17 1269.5 -1.5Q1223 -20 1185 -54Q1147 -88 1125 -135.5Q1103 -183 1103 -241Q1103 -295 1123 -341.5Q1143 -388 1179 -424Q1215 -460 1261.5 -480.5Q1308 -501 1361 -501Q1433 -501 1491.5 -466.5Q1550 -432 1585 -373Q1620 -314 1620 -242Q1620 -181 1597.5 -133.5Q1575 -86 1537.5 -52Q1500 -18 1454.5 -0.5Q1409 17 1363 17ZM1361 -134Q1385 -134 1410 -146Q1435 -158 1452 -182Q1469 -206 1469 -243Q1469 -275 1455 -299Q1441 -323 1416.5 -336.5Q1392 -350 1360 -350Q1330 -350 1306.5 -336Q1283 -322 1268.5 -297.5Q1254 -273 1254 -242Q1254 -206 1270.5 -181.5Q1287 -157 1312 -145.5Q1337 -134 1361 -134ZM1924 0Q1875 0 1837.5 -19.5Q1800 -39 1775.5 -72.5Q1751