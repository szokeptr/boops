---
import BotVisor from "../components/BotVisor.astro";
import Layout from "../layouts/Layout.astro";

const bots = [
  { name: "Juniper", state: "needs", status: "Needs you", hue: 8, accessory: "antenna" },
  { name: "Inbox Ranger", state: "working", status: "Sorting 38 emails…", hue: 200, accessory: "phones" },
  { name: "Ledger", state: "working", status: "Reconciling Oct…", hue: 45, accessory: "handle" },
  { name: "Gym Buddy", state: "idle", status: "Leg day moved", hue: 110, accessory: "none" },
  { name: "Biscuit", state: "sleep", status: "Dozing", hue: 258, accessory: "antenna" },
];

const states = [
  { state: "working", label: "Working", copy: "Its eyes scan while it works.", hue: 200 },
  { state: "needs", label: "Needs you", copy: "Its eyes go amber and your phone pings.", hue: 8 },
  { state: "sleep", label: "Dozing", copy: "Wakes up for its next routine.", hue: 258 },
];

const modes = [
  { tag: "01 · local", title: "Same machine", copy: "Open the desktop app and start hatching." },
  { tag: "02 · tailnet", title: "Tailscale", copy: "Your phone joins your tailnet. No ports open." },
  { tag: "03 · tunnel", title: "Boops Connect", copy: "An end-to-end encrypted tunnel for the rest." },
];

const comparison = [
  { row: "Where bots run", us: "Your machine", them: "Their computers" },
  { row: "Memory", us: "Files you own", them: "Inside an account" },
  { row: "Models", us: "Your Claude / Codex plan", them: "Theirs" },
  { row: "Source", us: "Open", them: "Closed" },
];
---

<Layout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow" data-rise><i aria-hidden="true"></i>Open source · runs on your machine</p>
        <h1 class="hero-title display" data-rise style="--d:90ms">Little bots that live on your machine.</h1>
        <p class="hero-lead" data-rise style="--d:180ms">
          Boops keeps one or many personal bots running on your own computer or VPS. Each has a
          name, a memory, routines, and one long conversation, powered by the Claude or Codex plan
          you already pay for.
        </p>
        <div class="hero-actions" data-rise style="--d:270ms">
          <a class="btn btn-primary btn-lg" href="/download">Download Boops</a>
          <button type="button" class="cmd" data-copy="npx boops-cli" aria-label="Copy npx boops-cli">
            <span class="cmd-prompt" aria-hidden="true">$</span>
            <code>npx boops-cli</code>
            <span class="cmd-hint pixel" data-copy-label>copy</span>
          </button>
        </div>
      </div>

      <div class="hero-mascot" data-rise style="--d:180ms" aria-hidden="true">
        <span class="bubble pixel">hi! I'm new</span>
        <BotVisor hue={258} accessory="antenna" size={208} />
      </div>
    </div>

    <!--
      BOOPS PRODUCT SCREENSHOT GOES HERE.
      Replace the mock window below with a real Boops desktop screenshot (bot list + one conversation)
      once one exists. The old T3 Code screenshot (src/assets/app-desktop.webp) is no longer rendered.
    -->
    <div class="container" data-rise style="--d:360ms">
      <div class="shot" role="img" aria-label="The Boops window: a list of bots with their status, and Juniper's conversation asking you to approve a reply.">
        <div class="shot-dots" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="shot-win">
          <div class="shot-side">
            <div class="shot-side-head pixel"><span>Bots</span><span>+ hatch</span></div>
            {bots.map((bot, index) => (
              <div class:list={["shot-bot", index === 0 && "is-on"]}>
                <span class="av"><BotVisor hue={bot.hue} state={bot.state as "idle" | "working" | "needs" | "sleep"} accessory={bot.accessory as "none" | "antenna" | "handle" | "phones"} /></span>
                <span class="shot-bot-text">
                  {bot.name}
                  <small class:list={[bot.state === "needs" && "is-needs"]}>{bot.status}</small>
                </span>
              </div>
            ))}
          </div>
          <div class="shot-conv">
            <div class="shot-conv-head">
              <span class="av"><BotVisor hue={8} state="needs" accessory="antenna" /></span>
              <span><b>Juniper</b><small>● Needs you</small></span>
            </div>
            <div class="shot-msgs">
              <div class="msg">
                <div class="msg-tag pixel">Routine · 21:40 inbox sweep</div>
                Your landlord replied about the radiator. They can send someone Thursday 9–11.
              </div>
              <div class="msg msg--me">Thursday works. Tell them yes.</div>
              <div class="msg-card">
                Draft ready: <i>“Thursday 9–11 is perfect, thanks! I'll be home.”</i>
                <div class="msg-card-row"><span>Send reply</span><span>Edit</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="bots" class="glance">
    <div class="container glance-grid">
      <h2 class="section-title">Every bot, at a glance.</h2>
      <div class="glance-tiles">
        {states.map((item) => (
          <div class="glance-tile">
            <span class="av av--lg"><BotVisor hue={item.hue} state={item.state as "working" | "needs" | "sleep"} accessory="antenna" size={56} /></span>
            <b>{item.label}</b>
            <p>{item.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="self-host" class="self is-night">
    <div class="container">
      <p class="eyebrow self-eyebrow"><i aria-hidden="true"></i>Self-host</p>
      <h2 class="display self-title">Runs where you do.</h2>
      <p class="self-lead">
        Your laptop, a mini PC under the desk, or a $5 VPS. Every bot, note and routine lives in
        folders you own, and your phone reaches it from anywhere.
      </p>

      <div class="term">
        <div><span class="term-dim">$</span> npx boops-cli</div>
        <div><span class="term-ok">✓</span> Server up on :3773</div>
        <div><span class="term-ok">✓</span> Found Claude Code (signed in)</div>
        <div><span class="term-ok">✓</span> 3 bots awake · 2 routines today</div>
        <div><span class="term-amber">→</span> Pair your phone: <span class="term-ok">boops pair</span></div>
      </div>

      <div class="modes">
        {modes.map((mode) => (
          <div class="mode">
            <span class="pixel">{mode.tag}</span>
            <b>{mode.title}</b>
            <p>{mode.copy}</p>
          </div>
        ))}
      </div>

      <div class="folder">
        <div class="tree">
          <div class="tree-dir">~/boops/juniper/</div>
          <div>├─ persona.md</div>
          <div>├─ <span class="tree-dir">memory/</span></div>
          <div>│  └─ landlord.md</div>
          <div>└─ <span class="tree-dir">routines/</span> <span class="tree-comment"># inbox sweep</span></div>
        </div>
        <div>
          <h3>A bot is a folder.</h3>
          <p>
            Its persona and the notes it keeps are plain Markdown. Back it up, grep it, move it to
            another box.
          </p>
        </div>
      </div>

      <div class="cmp">
        <h3>Boops vs. cloud bot apps</h3>
        <table>
          <thead>
            <tr><th scope="col"><span class="sr-only">Compared</span></th><th scope="col">Boops</th><th scope="col">Cloud bots</th></tr>
          </thead>
          <tbody>
            {comparison.map((item) => (
              <tr>
                <th scope="row">{item.row}</th>
                <td class="cmp-us">{item.us}</td>
                <td class="cmp-them">{item.them}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="hatch">
    <div class="container hatch-inner">
      <h2 class="display hatch-title">Hatch your first bot.</h2>
      <p class="hatch-lead">
        Run one command. Your new bot's first conversation is an interview: it asks about you, then
        writes its own persona.
      </p>
      <div class="hero-actions hatch-actions">
        <a class="btn btn-primary btn-lg" href="/download">Download Boops</a>
        <button type="button" class="cmd" data-copy="npx boops-cli" aria-label="Copy npx boops-cli">
          <span class="cmd-prompt" aria-hidden="true">$</span>
          <code>npx boops-cli</code>
          <span class="cmd-hint pixel" data-copy-label>copy</span>
        </button>
      </div>
    </div>
  </section>
</Layout>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    const label = button.querySelector<HTMLElement>("[data-copy-label]");
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        if (label) label.textContent = "copied";
      } catch {
        if (label) label.textContent = "select";
      }
      setTimeout(() => {
        if (label) label.textContent = "copy";
      }, 1600);
    });
  }
</script>

<style>
  section {
    position: relative;
    padding: 88px 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
  }

  .eyebrow i {
    width: 6px;
    height: 6px;
    background: var(--phosphor);
    outline: 2px solid var(--ink);
    display: inline-block;
  }

  /* Hero */
  .hero {
    padding: 56px 0 24px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 24px;
    align-items: end;
  }

  .hero-title {
    font-size: clamp(42px, 6vw, 76px);
    margin-bottom: 20px;
    max-width: 13ch;
    text-wrap: balance;
  }

  .hero-lead {
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.5;
    color: var(--fg-muted);
    max-width: 520px;
    margin-bottom: 30px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .cmd {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px;
    border: 1.5px solid var(--fg);
    border-radius: 999px;
    font-size: 14px;
    color: var(--fg);
    transition: background 0.18s ease;
  }

  .cmd:hover {
    background: color-mix(in srgb, var(--fg) 6%, transparent);
  }

  .cmd-prompt {
    font-family: var(--font-mono);
    color: var(--fg-faint);
  }

  .cmd-hint {
    font-size: 10px;
    color: var(--fg-dim);
  }

  .hero-mascot {
    position: relative;
    display: flex;
    justify-content: center;
    padding-top: 40px;
  }

  .hero-mascot :global(.bot-visor) {
    filter: drop-shadow(0 18px 30px rgba(29, 26, 42, 0.18));
  }

  .bubble {
    position: absolute;
    top: 0;
    right: 12%;
    background: var(--ink);
    color: var(--phosphor);
    padding: 8px 11px;
    border-radius: 4px;
  }

  .bubble::after {
    content: "";
    position: absolute;
    left: 14px;
    bottom: -6px;
    border: 6px solid transparent;
    border-top-color: var(--ink);
    border-bottom: 0;
  }

  /* Placeholder window until a real screenshot exists. */
  .shot {
    margin-top: 56px;
    background: var(--night);
    border-radius: 14px;
    padding: 12px;
    color: #ece9f5;
    box-shadow: 0 28px 60px -32px var(--ink);
  }

  .shot-dots {
    display: flex;
    gap: 6px;
    padding: 2px 4px 10px;
  }

  .shot-dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #3a3848;
  }

  .shot-win {
    display: grid;
    grid-template-columns: 240px 1fr;
    min-height: 340px;
    background: #1c1b25;
    border-radius: 8px;
    overflow: hidden;
  }

  .shot-side {
    background: #17161f;
    padding: 14px 10px;
    border-right: 1px solid rgba(255, 255, 255, 0.05);
  }

  .shot-side-head {
    display: flex;
    justify-content: space-between;
    margin: 0 6px 12px;
    color: #8c88a3;
  }

  .shot-bot {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 8px;
    border-radius: 8px;
    font-size: 14px;
  }

  .shot-bot.is-on {
    background: rgba(255, 255, 255, 0.05);
  }

  .shot-bot small,
  .shot-conv-head small {
    display: block;
    color: #8c88a3;
    font-size: 12px;
  }

  .shot-bot small.is-needs,
  .shot-conv-head small {
    color: var(--amber);
  }

  .shot-conv {
    display: flex;
    flex-direction: column;
  }

  .shot-conv-head {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 12px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 14px;
  }

  .shot-msgs {
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 14px;
    line-height: 1.45;
  }

  .msg {
    max-width: 78%;
    padding: 10px 14px;
    border-radius: 12px;
    background: #26243a;
  }

  .msg--me {
    align-self: flex-end;
    background: #33304e;
  }

  .msg-tag {
    color: #8c88a3;
    margin-bottom: 4px;
    font-size: 10px;
  }

  .msg-card {
    max-width: 86%;
    border: 1.5px solid var(--amber);
    border-radius: 12px;
    padding: 12px 14px;
  }

  .msg-card-row {
    display: flex;
    gap: 8px;
    margin-top: 10px;
  }

  .msg-card-row span {
    font-size: 12.5px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--amber);
    color: var(--ink);
    font-weight: 600;
  }

  .msg-card-row span + span {
    background: transparent;
    color: #ece9f5;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  /* Bot avatars: the SVG draws status in the eyes, so no corner badge. */
  .av {
    flex: none;
    display: inline-flex;
    line-height: 0;
  }

  /* Glance */
  .glance-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 32px;
    align-items: start;
  }

  .section-title {
    font-size: clamp(30px, 3.4vw, 42px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .glance-tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .glance-tile {
    border-top: 2px solid var(--ink);
    padding-top: 16px;
  }

  .glance-tile b {
    display: block;
    font-size: 17px;
    margin: 14px 0 4px;
  }

  .glance-tile p {
    color: var(--fg-muted);
    font-size: 15px;
    line-height: 1.45;
  }

  /* Self-host */
  .self {
    background: var(--night);
    color: var(--fg);
  }

  .self-eyebrow {
    color: var(--phosphor);
  }

  .self-eyebrow i {
    background: var(--night);
    outline-color: var(--phosphor);
  }

  .self-title {
    font-size: clamp(42px, 6vw, 72px);
    color: var(--paper);
    margin-bottom: 18px;
  }

  .self-lead {
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.5;
    color: var(--fg-muted);
    max-width: 560px;
  }

  .term {
    margin-top: 40px;
    background: #0e0d13;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 22px 24px;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.9;
    color: #cfcbe0;
    overflow-x: auto;
    white-space: nowrap;
  }

  .term-dim { color: var(--fg-faint); }
  .term-ok { color: var(--phosphor); }
  .term-amber { color: var(--amber); }

  .modes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 40px;
  }

  .mode {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 20px;
  }

  .mode .pixel {
    color: var(--phosphor);
  }

  .mode b {
    display: block;
    color: var(--paper);
    font-size: 17px;
    margin: 12px 0 4px;
  }

  .mode p {
    color: var(--fg-muted);
    font-size: 15px;
    line-height: 1.45;
  }

  .folder {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: center;
    margin-top: 56px;
  }

  .tree {
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.85;
    color: #cfcbe0;
    background: #0e0d13;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 18px 22px;
    white-space: pre;
    overflow-x: auto;
  }

  .tree-dir { color: var(--phosphor); }
  .tree-comment { color: var(--fg-faint); }

  .folder h3,
  .cmp h3 {
    font-size: clamp(24px, 2.6vw, 30px);
    letter-spacing: -0.02em;
    color: var(--paper);
    margin-bottom: 10px;
  }

  .folder p {
    color: var(--fg-muted);
    font-size: 16px;
    line-height: 1.5;
    max-width: 440px;
  }

  .cmp {
    margin-top: 64px;
    font-size: 15px;
  }

  .cmp table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 8px;
  }

  .cmp th,
  .cmp td {
    padding: 13px 12px 13px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    text-align: left;
    vertical-align: top;
    font-weight: 400;
  }

  .cmp thead th {
    color: var(--fg-faint);
  }

  .cmp tbody th {
    color: var(--fg-muted);
    width: 34%;
  }

  .cmp-us {
    color: var(--paper);
    font-weight: 600;
  }

  .cmp-us::before {
    content: "";
    display: inline-block;
    width: 7px;
    height: 7px;
    background: var(--phosphor);
    margin-right: 10px;
    vertical-align: 1px;
  }

  .cmp-them {
    color: var(--fg-dim);
  }

  /* Closing call */
  .hatch-inner {
    text-align: center;
  }

  .hatch-title {
    font-size: clamp(36px, 5vw, 60px);
    margin-bottom: 16px;
  }

  .hatch-lead {
    color: var(--fg-muted);
    font-size: 18px;
    max-width: 560px;
    margin: 0 auto 30px;
    text-wrap: balance;
  }

  .hatch-actions {
    justify-content: center;
  }

  @media (max-width: 960px) {
    .hero-grid,
    .glance-grid,
    .folder {
      grid-template-columns: 1fr;
    }

    .hero-mascot {
      order: -1;
      justify-content: flex-start;
      padding-top: 36px;
    }

    .hero-mascot img {
      width: 128px;
      height: 128px;
      border-radius: 28px;
    }

    .bubble {
      left: 140px;
      right: auto;
    }

    .shot-win {
      grid-template-columns: 1fr;
    }

    .shot-conv {
      display: none;
    }
  }

  @media (max-width: 720px) {
    section {
      padding: 64px 0;
    }

    .container {
      padding: 0 20px;
    }

    .glance-tiles,
    .modes {
      grid-template-columns: 1fr;
    }
  }
</style>
